# Скопируйте этот файл в .env и подставьте настоящий токен от @BotFather.
# Файл .env нельзя коммитить.
BOT_TOKEN=123456789:replace-with-token-from-botfather

# Путь к файлу SQLite (каталог будет создан автоматически)
DB_PATH=data/unimate.sqlite3

# Временная зона интерфейса и расчёта «сегодня»
TIMEZONE=Asia/Almaty

# DEBUG, INFO, WARNING, ERROR или CRITICAL
LOG_LEVEL=INFO
